---
const idiomas = [
  { locale: 'es', flag: '/flags/es.svg', label: 'Español' },
  { locale: 'en', flag: '/flags/gb.svg', label: 'English' },
  { locale: 'de', flag: '/flags/de.svg', label: 'Deutsch' },
];

const navLinks = [
  { label: 'Home',              to: '/' },
  { label: 'MUMA',             to: '/nosotros' },
  { label: 'Realidad Virtual', to: '/servicios/realidad-virtual' },
  { label: 'Bat Night',        to: '/servicios/bat-night' },
  { label: 'Refugios',         to: '/servicios/refugios' },
  { label: 'Formación',        to: '/servicios/formacion' },
  { label: 'Contacto',         to: '/contacto' },
];

const unirseOpciones = [
  { label: 'Voluntariado',       to: '/voluntarios' },
  { label: 'Ciencia ciudadana',  to: '/ciencia-ciudadana' },
];

const tiendaOpciones = [
  { label: 'Refugios para murciélagos', to: '/servicios/refugios' },
  { label: 'Productos educativos',      to: '/servicios/formacion' },
  { label: 'Experiencias',              to: '/servicios/bat-night' },
];

// As Astro resolves this at build time, we can precalculate the active path
const pathname = Astro.url.pathname;
const locale = 'es'; // Por defecto
---

<header class="fixed top-0 left-0 right-0 z-50" id="muma-navbar">
  {/* ── Header principal ── */}
  <div class="bg-fondo-base/95 backdrop-blur-md border-b border-white/5 relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12 py-4 md:py-5 flex items-center justify-between border-b border-white/5 gap-3">
      <a href="/" class="flex items-center gap-2 sm:gap-3 text-texto-titulo font-bold tracking-tight no-underline group min-w-0">
        <img
          src="/images/MUMA LOGO VECTOR-05_resultado.webp"
          alt="MUMA Bat Company Logo"
          class="h-9 w-auto object-contain transition-transform duration-300 group-hover:scale-110"
        />
        <div class="flex items-center gap-1 sm:gap-1.5 min-w-0">
          <span class="text-base sm:text-lg md:text-xl leading-none whitespace-nowrap">MUMA</span>
          <span class="text-marca-principal text-base sm:text-lg md:text-xl leading-none whitespace-nowrap">BAT COMPANY</span>
        </div>
      </a>

      <div class="hidden md:flex items-center gap-2 lg:gap-3 relative" id="desktop-nav-right">
        <div class="flex items-center gap-1 shrink-0">
          {idiomas.map((idioma) => (
            <button
              class={`w-8 h-6 rounded-lg transition-all duration-200 cursor-pointer flex items-center justify-center shrink-0 ${
                locale === idioma.locale
                  ? 'ring-2 ring-marca-principal/70 scale-110'
                  : 'opacity-50 hover:opacity-90 hover:bg-white/5'
              }`}
            >
              <img src={idioma.flag} alt={idioma.label} width="24" height="18" class="w-6 h-4 rounded-sm object-cover" />
            </button>
          ))}
        </div>
        <div class="w-px h-6 bg-white/10"></div>
        <a
          href="https://www.murcielagosmalaga.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-1.5 px-2.5 lg:px-3 py-2 rounded-lg text-[11px] lg:text-xs font-semibold border border-purple-400/60 text-texto-secundario hover:text-texto-titulo hover:border-purple-400/80 bg-marca-principal/5 hover:bg-marca-principal/10 transition-all duration-200 no-underline shrink-0"
        >
          <img src="/images/logo-murcielagos-malaga.png" alt="Murciélagos Málaga" class="h-5 w-auto invert opacity-70 group-hover:opacity-100 transition-opacity" />
          <span class="hidden lg:inline">murcielagosmalaga.com</span>
        </a>
        <div class="w-px h-6 bg-white/10"></div>
        
        {/* Dropdown Unirse */}
        <div class="relative muma-dropdown" data-dropdown="unirse">
          <button class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 cursor-pointer border border-purple-400/60 text-texto-secundario hover:text-texto-titulo hover:border-purple-400/80 dropdown-btn">
            Unirse
            <svg class="w-3.5 h-3.5 transition-transform duration-200 chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute right-0 top-full mt-2 w-56 bg-fondo-secundario border border-white/10 rounded-xl shadow-xl overflow-hidden z-50 hidden dropdown-menu">
            {unirseOpciones.map((opcion) => (
              <a href={opcion.to} class="block px-4 py-3 text-sm text-texto-secundario hover:text-texto-titulo hover:bg-white/5 transition-colors no-underline">
                {opcion.label}
              </a>
            ))}
          </div>
        </div>

        <a
          href="/donar"
          class="flex items-center px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 border border-purple-400/60 text-texto-titulo bg-marca-principal/5 hover:bg-marca-principal/20 hover:border-purple-400/80 no-underline shadow-sm"
        >
          Donar
        </a>

        {/* Dropdown Tienda */}
        <div class="relative muma-dropdown" data-dropdown="tienda">
          <button class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 cursor-pointer bg-marca-principal text-black hover:bg-marca-principal-hover dropdown-btn">
            Tienda
            <svg class="w-3.5 h-3.5 transition-transform duration-200 chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute right-0 top-full mt-2 w-56 bg-fondo-secundario border border-white/10 rounded-xl shadow-xl overflow-hidden z-50 hidden dropdown-menu">
            {tiendaOpciones.map((opcion) => (
              <a href={opcion.to} class="block px-4 py-3 text-sm text-texto-secundario hover:text-texto-titulo hover:bg-white/5 transition-colors no-underline">
                {opcion.label}
              </a>
            ))}
          </div>
        </div>

        <div class="w-px h-6 bg-white/10 mx-1"></div>
        
        {/* Zona Privada Reactiva Vanilla JS */}
        <div id="auth-unlogged" class="hidden">
          <a
            href="/login"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold transition-all duration-300 text-marca-principal border border-purple-400/60 hover:bg-marca-principal/10 hover:border-purple-400/80 no-underline shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>Área Especialistas</span>
          </a>
        </div>

        <div id="auth-logged" class="relative muma-dropdown hidden" data-dropdown="usuario">
          <button class="flex items-center gap-2 p-1.5 pr-3 rounded-full text-sm font-medium transition-colors duration-200 border bg-white/5 border-purple-400/60 hover:border-purple-400/80 text-white dropdown-btn">
            <div id="auth-avatar" class="w-6 h-6 rounded-full bg-marca-principal text-black flex items-center justify-center font-bold text-xs uppercase">
              U
            </div>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          
          <div class="absolute right-0 top-full mt-2 w-48 bg-fondo-secundario border border-white/10 rounded-xl shadow-xl overflow-hidden z-50 hidden dropdown-menu">
            <div class="px-4 py-3 border-b border-white/10">
              <p id="auth-name" class="text-sm font-semibold text-white truncate">Usuario</p>
              <p id="auth-email" class="text-xs text-zinc-400 truncate">email@example.com</p>
            </div>
            <a href="/admin" class="block px-4 py-2.5 text-sm text-zinc-300 hover:text-white hover:bg-white/5 no-underline">
              Panel de Administración
            </a>
            <button id="auth-signout" class="w-full text-left px-4 py-2.5 text-sm text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-colors">
              Cerrar sesión
            </button>
          </div>
        </div>
      </div>

      <button id="mobile-menu-btn" class="md:hidden flex flex-col justify-center gap-1.5 w-8 h-8 p-1 relative z-50 shrink-0">
        <span class="block w-full h-0.5 bg-white transition-all duration-300 bar1"></span>
        <span class="block w-full h-0.5 bg-white transition-all duration-300 bar2"></span>
        <span class="block w-full h-0.5 bg-white transition-all duration-300 bar3"></span>
      </button>
    </div>

    <div class="hidden md:block">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12 py-4 flex items-center justify-center gap-0.5">
        {navLinks.map((link) => (
          <a
            href={link.to}
            class={`px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors duration-200 no-underline ${
              pathname === link.to || (pathname !== '/' && link.to !== '/' && pathname.startsWith(link.to))
                ? 'text-marca-principal bg-marca-principal/10'
                : 'text-white hover:text-marca-principal hover:bg-white/5'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div id="mobile-menu" class="md:hidden bg-fondo-secundario border-t border-white/5 p-4 sm:p-6 flex flex-col gap-4 absolute top-full left-0 right-0 hidden shadow-2xl z-40 max-h-[85vh] overflow-y-auto">
      {navLinks.map((link) => (
        <a href={link.to} class="text-sm font-medium text-white hover:text-marca-principal no-underline">
          {link.label}
        </a>
      ))}
      <div class="border-t border-white/10 pt-4 flex flex-col gap-3">
        <p class="text-xs text-texto-secundario/50 uppercase tracking-wider">Unirse</p>
        {unirseOpciones.map((op) => (
          <a href={op.to} class="text-sm font-medium text-white hover:text-marca-principal no-underline">{op.label}</a>
        ))}
      </div>
      <div class="border-t border-white/10 pt-4 flex flex-col gap-3">
        <p class="text-xs text-texto-secundario/50 uppercase tracking-wider">Tienda</p>
        {tiendaOpciones.map((op) => (
          <a href={op.to} class="text-sm font-medium text-white hover:text-marca-principal no-underline">{op.label}</a>
        ))}
      </div>
      <a href="/donar" class="mt-1 text-center px-4 py-2 rounded-lg text-sm font-semibold border border-marca-principal/30 text-texto-titulo bg-marca-principal/5 hover:bg-marca-principal/20 no-underline">
        Donar
      </a>

      <a
        href="https://www.murcielagosmalaga.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 flex items-center justify-center gap-2 text-center px-4 py-2 rounded-lg text-sm font-semibold border border-purple-400/50 text-texto-secundario bg-marca-principal/5 hover:bg-marca-principal/15 hover:text-texto-titulo no-underline"
      >
        <img src="/images/logo-murcielagos-malaga.png" alt="Murciélagos Málaga" class="h-4 w-auto invert opacity-80" />
        murcielagosmalaga.com
      </a>

      {/* --- ZONA MÓVIL (Versión extendida condicional) --- */}
      <div class="border-t border-white/10 pt-4 flex flex-col gap-3">
        <p id="mobile-auth-title" class="text-xs text-texto-secundario/50 uppercase tracking-wider">
          Acceso Privado
        </p>
        
        <div id="mobile-auth-unlogged" class="hidden">
          <a href="/login" class="flex items-center gap-2 text-sm font-medium text-texto-secundario hover:text-marca-principal no-underline">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> Entrar
          </a>
        </div>

        <div id="mobile-auth-logged" class="hidden flex-col gap-3">
          <div class="flex items-center gap-2 text-sm text-zinc-400 mb-1 px-2 py-1 bg-white/5 rounded">
            <span id="mobile-auth-avatar" class="w-5 h-5 rounded-full bg-marca-principal text-black flex items-center justify-center font-bold text-[10px] uppercase">
              U
            </span>
            <span id="mobile-auth-email">email@example.com</span>
          </div>
          <a href="/admin" class="text-sm font-medium text-texto-secundario hover:text-white no-underline">
            Panel de Administración
          </a>
          <button id="mobile-auth-signout" class="text-left text-sm font-medium text-red-500 hover:text-red-400">
            Cerrar sesión
          </button>
        </div>
      </div>
      {/* --- FIN ZONA MÓVIL --- */}

      <div class="border-t border-white/10 pt-4 flex items-center gap-2">
        {idiomas.map((idioma) => (
          <button
            class={`w-8 h-6 rounded-lg transition-all duration-200 cursor-pointer flex items-center justify-center shrink-0 ${
              locale === idioma.locale ? 'ring-2 ring-marca-principal/70 scale-110' : 'opacity-50 hover:opacity-90 hover:bg-white/5'
            }`}
          >
            <img src={idioma.flag} alt={idioma.label} width="24" height="18" class="w-6 h-4 rounded-sm object-cover" />
          </button>
        ))}
      </div>
    </div>
  </div>{/* fin header principal */}
</header>

<script>
  import { supabase } from '../../lib/supabase'

  document.addEventListener('DOMContentLoaded', async () => {
    // 1. MOBILE MENU
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const b1 = mobileBtn?.querySelector('.bar1');
    const b2 = mobileBtn?.querySelector('.bar2');
    const b3 = mobileBtn?.querySelector('.bar3');

    mobileBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
      const isOpen = !mobileMenu?.classList.contains('hidden');
      if (isOpen) {
        b1?.classList.add('rotate-45', 'translate-y-2');
        b2?.classList.add('opacity-0');
        b3?.classList.add('-rotate-45', '-translate-y-2');
      } else {
        b1?.classList.remove('rotate-45', 'translate-y-2');
        b2?.classList.remove('opacity-0');
        b3?.classList.remove('-rotate-45', '-translate-y-2');
      }
    });

    // 2. DROPDOWNS DESKTOP
    const dropdowns = document.querySelectorAll('.muma-dropdown');
    
    dropdowns.forEach(dropdown => {
      const btn = dropdown.querySelector('.dropdown-btn');
      const menu = dropdown.querySelector('.dropdown-menu');
      const chevron = dropdown.querySelector('.chevron');

      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        
        // Cerrar otros
        dropdowns.forEach(other => {
          if (other !== dropdown) {
            other.querySelector('.dropdown-menu')?.classList.add('hidden');
            other.querySelector('.chevron')?.classList.remove('rotate-180');
          }
        });

        // Toggle actual
        menu?.classList.toggle('hidden');
        chevron?.classList.toggle('rotate-180');
      });
    });

    // Cerrar al clickear fuera
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.muma-dropdown')) {
        dropdowns.forEach(dropdown => {
          dropdown.querySelector('.dropdown-menu')?.classList.add('hidden');
          dropdown.querySelector('.chevron')?.classList.remove('rotate-180');
        });
      }
    });

    // 3. AUTH STATE (Supabase)
    const { data: { session } } = await supabase.auth.getSession();
    
    // Desktop elements
    const authUnlogged = document.getElementById('auth-unlogged');
    const authLogged = document.getElementById('auth-logged');
    const authAvatar = document.getElementById('auth-avatar');
    const authName = document.getElementById('auth-name');
    const authEmail = document.getElementById('auth-email');
    const authSignout = document.getElementById('auth-signout');

    // Mobile elements
    const mobileAuthTitle = document.getElementById('mobile-auth-title');
    const mobileAuthUnlogged = document.getElementById('mobile-auth-unlogged');
    const mobileAuthLogged = document.getElementById('mobile-auth-logged');
    const mobileAuthAvatar = document.getElementById('mobile-auth-avatar');
    const mobileAuthEmail = document.getElementById('mobile-auth-email');
    const mobileAuthSignout = document.getElementById('mobile-auth-signout');

    if (session && session.user) {
      // Get user metadata
      const name = session.user.user_metadata?.nombre || 'Usuario';
      const initial = name.charAt(0).toUpperCase();
      const email = session.user.email || '';

      // Update Desktop
      if (authAvatar) authAvatar.textContent = initial;
      if (authName) authName.textContent = name;
      if (authEmail) authEmail.textContent = email;
      authUnlogged?.classList.add('hidden');
      authLogged?.classList.remove('hidden');

      // Update Mobile
      if (mobileAuthTitle) mobileAuthTitle.textContent = 'Mi Cuenta';
      if (mobileAuthAvatar) mobileAuthAvatar.textContent = initial;
      if (mobileAuthEmail) mobileAuthEmail.textContent = email;
      mobileAuthUnlogged?.classList.add('hidden');
      mobileAuthLogged?.classList.remove('hidden');
      mobileAuthLogged?.classList.add('flex');
    } else {
      // Show unlogged state
      authUnlogged?.classList.remove('hidden');
      mobileAuthUnlogged?.classList.remove('hidden');
    }

    // Signout handlers
    const handleSignout = async () => {
      await supabase.auth.signOut();
      window.location.reload();
    };

    authSignout?.addEventListener('click', handleSignout);
    mobileAuthSignout?.addEventListener('click', handleSignout);

    // Listen for auth changes
    supabase.auth.onAuthStateChange((event) => {
      if (event === 'SIGNED_IN' || event === 'SIGNED_OUT') {
        // window.location.reload(); // Comentado para evitar bucles infinitos de redirección
        console.log("Auth event detected:", event);
      }
    });
  });
</script>
