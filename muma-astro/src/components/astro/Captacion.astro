---
import FormularioMuma from "../formularioContacto";
---
<section class="relative py-24 px-6 overflow-hidden border-t border-white/5">
  <div class="absolute inset-0 z-0">
    <img src="/images/bat-night-eslovenia.webp" alt="" class="w-full h-full object-cover opacity-20" />
    <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-[#050505]/80 to-[#050505]"></div>
  </div>
  <div class="relative z-10 max-w-2xl mx-auto text-center">
    <p class="text-[#10b981] text-xs font-bold tracking-[0.3em] uppercase mb-4">Batcave Experience — Lista de espera</p>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 leading-tight">
      Sé el primero en saber <br /> cuándo está disponible.
    </h2>
    <p class="text-white/70 mb-10 max-w-md mx-auto">
      Más de 700 personas ya la han probado en eventos. Cuando abramos acceso directo, avisamos primero a esta lista.
    </p>

    <FormularioMuma 
      client:visible
      tablaBD="consultas_web"
      asuntoCorreo="[Web Inicio] Nueva alta en lista de espera Batcave"
      textoBoton="APUNTARME AHORA"
      mostrarNombre={false}
      mostrarOrganizacion={false}
      mostrarTelefono={false}
      mostrarMensaje={false}
      mostrarSelect={false}
      mostrarFecha={false}
      mostrarParticipantes={false}
      nombreCampoNombre="nombre_contacto"
      camposOcultos={{
        tipo_solicitud: 'batcave_waitlist',
        origen: 'web_inicio'
      }}
    />

    <p class="text-white/50 text-xs mt-6">Sin spam. Solo novedades de la Batcave Experience.</p>
  </div>
</section>
